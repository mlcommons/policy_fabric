        },
        "intendedDataUse": {
          "from": "presented"
        },
        "agreement": {
          "from": "presented"
        }
      },
      "policy_data": {}
    }
  },
  "capability": {
    "operation": "do_download",
    "requires": [
      "project_specific_restriction"
    ],
    "parameters": {
      "channel_key": {
        "type": "publicKeyCredential",
        "role": "User",
        "claim": "key"
      }
    }
  },
  "trusted_issuers": {
    "AgreementCredential": [],
    "IntendedDataUseCredential": [],
    "ProjectMembershipCredential": [],
    "ProjectOwnershipCredential": [],
    "TeamCredential": [],
    "publicKeyCredential": []
  }
