{
  "version": 3,
  "name": "Project Specific Restriction",
  "nodes": {
    "project_membership": {
      "component": "project_membership",
      "inputs": {
        "team": {
          "from": "presented"
        },
        "ownership": {
          "from": "presented"
        }
      },
      "policy_data": {}
    },
    "project_specific_restriction": {
      "component": "project_specific_restriction",
      "inputs": {
        "projectMembership": {
          "from": "node",
          "node": "project_membership",
